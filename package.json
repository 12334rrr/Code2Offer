{
  "name": "code2offer",
  "version": "0.9.1",
  "private": true,
  "license": "MIT",
  "description": "Code2Offer(代码转面试):读取完整代码仓库,用 DeepSeek 生成真实面试场景全套材料(项目讲解/百问百答/亮点防守/缺点改进/选型横向对比/HTML报告/模拟排练)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12334rrr/Code2Offer.git"
  },
  "bin": {
    "code2offer": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "node dist/cli/index.js generate",
    "rehearse": "node dist/cli/index.js rehearse",
    "export-prompts": "node dist/cli/index.js export-prompts docs/prompts",
    "demo": "npm run build && node dist/cli/index.js generate ./example-demo --jd example-demo/jd.txt",
    "demo:rehearse": "node dist/cli/index.js rehearse ./example-demo/interview-output --count 3",
    "test": "npm run clean:dist && npm run build && node --test \"dist/tests/*.test.js\"",
    "test:mock-api": "npm run build && node audit/mock-api-contract.cjs",
    "test:performance": "npm run build && node audit/performance-mock.cjs",
    "test:extension-host": "node audit/extension-host-smoke.cjs",
    "test:vsix": "node audit/vsix-content-check.cjs && node audit/activation-smoke.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@tavily/core": "^0.7.12",
    "langchain": "^1.5.11"
  }
}
